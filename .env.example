# ============================================================
# ShikshaMitra AI — Environment Configuration Example
# Copy this file to .env.local for local development.
# ============================================================

# Google Gemini API Key (Server-side only — NEVER use NEXT_PUBLIC_)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
# If this key is omitted, the application will remain fully functional
# with built-in curriculum hints and offline tutoring fallbacks.
GEMINI_API_KEY=your_gemini_api_key_here
